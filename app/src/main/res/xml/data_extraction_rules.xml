<?xml version="1.0" encoding="utf-8"?>
<!-- 本应用不落任何本地数据，云备份与设备迁移一律排除 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
